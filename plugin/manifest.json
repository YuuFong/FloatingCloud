{
  "$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/master/manifest-schema.json",
  "manifest_version": 1,
  "name": "FloatingCloud",
  "slug": "floatingcloud-lite",
  "version": "0.4.14-beta",
  "author": "FloatingCloud",
  "description": "按 TBL v1.7.4 实际逐词透明度分层修复未唱文字与译文色阶，新增 32 柱频谱单柱宽度设置。",
  "type": "extension",
  "ncm3-compatible": true,
  "ncm-version-req": ">=3.1.42 <3.1.43",
  "require_restart": true,
  "native_plugin": "native.dll",
  "injects": {
    "Main": [
      {
        "file": "core.js"
      },
      {
        "file": "ncm-path.js"
      },
      {
        "file": "vendor/tbl-presentation.js"
      },
      {
        "file": "main.js"
      }
    ]
  }
}
