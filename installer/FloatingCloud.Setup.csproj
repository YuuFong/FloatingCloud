<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FloatingCloud.Setup</AssemblyName>
    <ApplicationTitle>FloatingCloud Setup</ApplicationTitle>
    <Version>0.5.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The native plugin is built and validated before this project is published. -->
    <EmbeddedResource Include="../dist/bundled/FloatingCloud.plugin" LogicalName="FloatingCloud.Setup.BundledPlugin" />
    <EmbeddedResource Include="../dist/bundled/InfLink-rs.plugin" LogicalName="FloatingCloud.Setup.InfLinkPlugin" />
    <EmbeddedResource Include="../dist/bundled/InfLink-rs-LICENSE.txt" LogicalName="FloatingCloud.Setup.InfLinkLicense" />
  </ItemGroup>
</Project>
